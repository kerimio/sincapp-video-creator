# KI zum Auslesen – einer der beiden reicht. Empfohlen: Gemini (am günstigsten).
# Sind beide da, wird Gemini genommen; ändern mit SINCAPP_AI=claude
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Seiten lesen (Standard gemini-3.8-flash). Nur bei schwierigen Prospekten das teurere gemini-4-argon nehmen.
# GEMINI_MODEL=
# Preis-Gegencheck und Bildvergleich (Standard gemini-3.8-flash)
# GEMINI_CHECK_MODEL=
# Claude: Seiten lesen (Standard claude-sonnet-5-5), Gegencheck/Bildvergleich (Standard claude-haiku-5-5)
# SINCAPP_MODEL=
# SINCAPP_CHECK_MODEL=
# Optional: Fallback fürs Freistellen
REMOVEBG_API_KEY=
# Optional: Bildersuche für Produktfotos (Brave Search API)
BRAVE_API_KEY=
