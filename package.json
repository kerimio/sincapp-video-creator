{
  "name": "sincapp-story",
  "version": "0.1.0",
  "private": true,
  "description": "Prospekt rein, Instagram-Story (MP4) raus – Story-Generator für sincapp",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "bin": {
    "sincapp-story": "./bin/sincapp-story.mjs"
  },
  "scripts": {
    "build:template": "vite build --config vite.config.ts",
    "dev:template": "vite --config vite.config.ts",
    "schemas": "tsx tools/export-schemas.ts",
    "cli": "tsx src/cli/index.ts",
    "diff:reference": "pnpm build:template && tsx tools/diff-reference.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup:python": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
    "eval:saray": "tsx tools/eval-saray.ts",
    "build:review": "vite build --config vite.review.config.ts",
    "review": "tsx src/cli/index.ts review"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "commander": "^14.0.0",
    "playwright": "1.63.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
