{
  "$ref": "#/definitions/story",
  "definitions": {
    "story": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1,
          "default": 1
        },
        "market": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "slug": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "logo": {
              "type": "string",
              "minLength": 1
            },
            "logoCrop": {
              "type": "object",
              "properties": {
                "w": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "h": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "offsetX": {
                  "type": "number",
                  "minimum": 0
                },
                "offsetY": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "w",
                "h",
                "offsetX",
                "offsetY"
              ],
              "additionalProperties": false
            },
            "instagram": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._]+$"
            },
            "addresses": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "maxItems": 3
            },
            "theme": {
              "type": "object",
              "properties": {
                "pages": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "red",
                      "nut"
                    ]
                  },
                  "minItems": 1
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "slug",
            "logo",
            "addresses"
          ],
          "additionalProperties": false
        },
        "lang": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "de",
              "tr"
            ]
          },
          "minItems": 1,
          "default": [
            "de",
            "tr"
          ]
        },
        "dates": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "to": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        "headline": {
          "type": "object",
          "properties": {
            "de": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "maxItems": 2
            },
            "tr": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "maxItems": 2
            }
          },
          "required": [
            "de",
            "tr"
          ],
          "additionalProperties": false
        },
        "eyebrow": {
          "type": "object",
          "properties": {
            "de": {
              "type": "string"
            },
            "tr": {
              "type": "string"
            }
          },
          "required": [
            "de",
            "tr"
          ],
          "additionalProperties": false
        },
        "offers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "img": {
                "type": "string",
                "minLength": 1
              },
              "price": {
                "type": "string",
                "pattern": "^\\d{1,4},\\d{2}$"
              },
              "unit": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "de": {
                        "type": "string"
                      },
                      "tr": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "de",
                      "tr"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "name": {
                "type": "object",
                "properties": {
                  "de": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "maxItems": 2
                  },
                  "tr": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "maxItems": 2
                  }
                },
                "required": [
                  "de",
                  "tr"
                ],
                "additionalProperties": false
              },
              "note": {
                "type": "object",
                "properties": {
                  "de": {
                    "type": "string"
                  },
                  "tr": {
                    "type": "string"
                  }
                },
                "required": [
                  "de",
                  "tr"
                ],
                "additionalProperties": false
              },
              "imgZoom": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 3,
                "default": 1
              },
              "badge": {
                "type": "string",
                "enum": [
                  "knaller",
                  "woche",
                  "neu",
                  "halal",
                  "bio",
                  "bestpreis",
                  "frisch",
                  "aktion",
                  "vorrat",
                  "xxl"
                ]
              },
              "bestWeeks": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 104
              },
              "market": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "img",
              "price",
              "name"
            ],
            "additionalProperties": false
          },
          "minItems": 2
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "number",
            "enum": [
              2,
              3
            ]
          }
        },
        "appScreenshot": {
          "type": "string"
        },
        "scenes": {
          "type": "object",
          "properties": {
            "intro": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 3.6
            },
            "page": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 4.5
            },
            "cta": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 6
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "banner": {
          "type": "object",
          "properties": {
            "de": {
              "type": "string"
            },
            "tr": {
              "type": "string"
            }
          },
          "required": [
            "de",
            "tr"
          ],
          "additionalProperties": false
        },
        "design": {
          "type": "object",
          "properties": {
            "preset": {
              "type": "string",
              "enum": [
                "marke",
                "klassik",
                "frisch",
                "premium",
                "knallig",
                "minimal",
                "blackweek",
                "bayram",
                "sommer"
              ],
              "default": "klassik"
            },
            "colors": {
              "type": "object",
              "properties": {
                "paper": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "ink": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "ink2": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "accent": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "accent2": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "pages": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "minItems": 1,
                  "maxItems": 4
                }
              },
              "additionalProperties": false
            },
            "background": {
              "type": "string",
              "enum": [
                "logo",
                "punkte",
                "verlauf",
                "sterne",
                "streifen",
                "ohne"
              ]
            },
            "price": {
              "type": "string",
              "enum": [
                "etikett",
                "kreis",
                "flach"
              ]
            },
            "enter": {
              "type": "string",
              "enum": [
                "wischen",
                "hoch",
                "blende",
                "pop"
              ]
            },
            "speed": {
              "type": "string",
              "enum": [
                "ruhig",
                "normal",
                "schnell"
              ]
            },
            "wobble": {
              "type": "boolean"
            },
            "transition": {
              "type": "string",
              "enum": [
                "kreis",
                "schieben",
                "blende"
              ]
            },
            "qr": {
              "type": "string",
              "enum": [
                "aus",
                "route",
                "instagram",
                "link"
              ]
            },
            "qrLink": {
              "type": "string",
              "format": "uri",
              "maxLength": 500
            }
          },
          "additionalProperties": false
        },
        "markets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "logo": {
                "type": "string",
                "minLength": 1
              },
              "address": {
                "type": "string"
              },
              "instagram": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._]+$"
              },
              "dates": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  }
                },
                "required": [
                  "from",
                  "to"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "market",
        "dates",
        "headline",
        "offers"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
