{
  "$ref": "#/definitions/market",
  "definitions": {
    "market": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "logo": {
          "type": "string",
          "minLength": 1
        },
        "logoCrop": {
          "type": "object",
          "properties": {
            "w": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "h": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "offsetX": {
              "type": "number",
              "minimum": 0
            },
            "offsetY": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "w",
            "h",
            "offsetX",
            "offsetY"
          ],
          "additionalProperties": false
        },
        "instagram": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._]+$"
        },
        "addresses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 3
        },
        "theme": {
          "type": "object",
          "properties": {
            "pages": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "red",
                  "nut"
                ]
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "slug",
        "logo",
        "addresses"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
